FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

4
(
    tankWall
    {
        type            wall;
        inGroups        1(wall);
        nFaces          2304;
        startFace       39456;
    }
    lid
    {
        type            wall;
        inGroups        1(wall);
        nFaces          0;
        startFace       41760;
    }
    procBoundary1to0
    {
        type            processor;
        inGroups        1(processor);
        nFaces          1152;
        startFace       41760;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        1;
        neighbProcNo    0;
    }
    procBoundary1to3
    {
        type            processor;
        inGroups        1(processor);
        nFaces          576;
        startFace       42912;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        1;
        neighbProcNo    3;
    }
)

