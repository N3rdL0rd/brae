FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

2
(
    tankWall
    {
        type            wall;
        inGroups        1(wall);
        nFaces          8064;
        startFace       161280;
    }
    lid
    {
        type            wall;
        inGroups        1(wall);
        nFaces          1152;
        startFace       169344;
    }
)

